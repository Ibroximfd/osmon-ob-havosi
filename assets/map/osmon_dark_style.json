{
  "version": 8,
  "id": "osmon-night",
  "metadata": {"version": "1"},
  "sources": {"openmaptiles": {"type": "vector"}},
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#0A1524"}},
    {"id": "landcover-wood", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", "class", "wood"], "paint": {"fill-color": "#0F1D2C", "fill-opacity": 0.8}},
    {"id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
     "filter": ["==", "class", "sand"], "paint": {"fill-color": "#1A1C22", "fill-opacity": 0.7}},
    {"id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
     "filter": ["==", "class", "residential"], "paint": {"fill-color": "#13223A", "fill-opacity": 0.7}},
    {"id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
     "paint": {"fill-color": "#102A2A", "fill-opacity": 0.6}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
     "paint": {"fill-color": "#0E2E4A"}},
    {"id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
     "minzoom": 6, "paint": {"line-color": "#174566", "line-width": 1}},
    {"id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
     "minzoom": 10, "filter": ["in", "class", "minor", "tertiary", "secondary"],
     "paint": {"line-color": "#1E2F46", "line-width": 1}},
    {"id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
     "minzoom": 5, "filter": ["in", "class", "primary", "trunk"],
     "paint": {"line-color": "#2A4060", "line-width": 1.2}},
    {"id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
     "minzoom": 4, "filter": ["==", "class", "motorway"],
     "paint": {"line-color": "#33507A", "line-width": 1.6}},
    {"id": "boundary-state", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
     "minzoom": 4, "filter": ["all", ["==", "admin_level", 4], ["!=", "maritime", 1]],
     "paint": {"line-color": "#2B4466", "line-width": 0.8, "line-dasharray": [3, 2]}},
    {"id": "boundary-country", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
     "filter": ["all", ["==", "admin_level", 2], ["!=", "maritime", 1]],
     "paint": {"line-color": "#5A7CA6", "line-width": 1.4}},
    {"id": "place-town", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
     "minzoom": 8, "filter": ["in", "class", "town", "village"],
     "layout": {"text-field": "__NAME__", "text-size": 11, "text-font": ["Noto Sans Regular"]},
     "paint": {"text-color": "#9FB4CF", "text-halo-color": "#0A1524", "text-halo-width": 1.2}},
    {"id": "place-city", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
     "minzoom": 5, "filter": ["==", "class", "city"],
     "layout": {"text-field": "__NAME__", "text-size": 12, "text-font": ["Noto Sans Bold"]},
     "paint": {"text-color": "#D7E3F2", "text-halo-color": "#0A1524", "text-halo-width": 1.4}},
    {"id": "place-country", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
     "maxzoom": 7, "filter": ["==", "class", "country"],
     "layout": {"text-field": "__NAME__", "text-size": 12, "text-transform": "uppercase", "text-letter-spacing": 0.2, "text-font": ["Noto Sans Bold"]},
     "paint": {"text-color": "#6F8FB8", "text-halo-color": "#0A1524", "text-halo-width": 1}}
  ]
}
